<?xml version="1.0" encoding="utf-8"?>
<!-- A voice, drawn as what the shop actually sees: sound going in, a bill coming out.
     Concentric arcs opening to the right are the listening half; the upright bars they
     open onto are a receipt's lines. It has to survive being 48dp on a cracked screen in
     daylight, so it is three strokes and no detail.

     Adaptive icons put the safe zone in the middle 66dp of 108dp; everything here sits
     inside a 72dp box centred at 54,54 so no launcher mask can clip it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- the listening arcs -->
    <path
        android:pathData="M38,40 A18,18 0 0 1 38,68"
        android:strokeColor="#5CE1C6" android:strokeWidth="5.5"
        android:strokeLineCap="round" android:fillColor="@android:color/transparent" />
    <path
        android:pathData="M30,32 A28,28 0 0 1 30,76"
        android:strokeColor="#5CE1C6" android:strokeWidth="5.5"
        android:strokeLineCap="round" android:fillColor="@android:color/transparent"
        android:strokeAlpha="0.55" />

    <!-- the bill: three lines, shortening, the way a total sits under items -->
    <path android:pathData="M52,42 L78,42"
        android:strokeColor="#FFFFFF" android:strokeWidth="5.5" android:strokeLineCap="round" />
    <path android:pathData="M52,54 L78,54"
        android:strokeColor="#FFFFFF" android:strokeWidth="5.5" android:strokeLineCap="round" />
    <path android:pathData="M52,66 L68,66"
        android:strokeColor="#5CE1C6" android:strokeWidth="5.5" android:strokeLineCap="round" />
</vector>

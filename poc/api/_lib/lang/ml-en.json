    "oppam",
    "plus",
    "கலந்து",
    "பிளஸ்",
    "ഒപ്പം",
    "കൂടെ"
  ],
  "_comment_customer": "Opens a bill against a customer: 'phone number 98400 12345'. Bare 'number' is listed but only fires when 10+ digits follow, because 'number' is also a unit alias for pieces.",

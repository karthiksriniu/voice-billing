#!/usr/bin/env bash
# Wrapper so node/vercel are on PATH without touching your shell profile.
#
#   ./bolo dev        run locally on :8077
#   ./bolo staging    deploy this branch to bolo-bill-staging.vercel.app
#   ./bolo deploy     deploy to production (main branch only)
#   ./bolo env        add the API keys (prompts; nothing is echoed)
#   ./bolo test       run the parser fixtures
#   ./bolo login      authenticate the GitHub CLI (one time, interactive)
set -euo pipefail
cd "$(dirname "$0")"
export PATH="$PWD/.tools/node/bin:$PWD/.tools/gh/bin:$PATH"

branch() { git rev-parse --abbrev-ref HEAD; }

case "${1:-dev}" in
  dev)
    # Stamped before serving. The cache-buster only moved at deploy time, so editing a JS
    # file locally left the browser holding the previous one behind an unchanged ?v= — the
    # page looks reloaded and is not, and you debug code that is no longer running.
    ./stamp.sh >/dev/null
    exec .venv/bin/uvicorn api.index:app --reload --host 0.0.0.0 --port 8077
    ;;

  staging)
    ./stamp.sh
    # The CLI ends with a JSON summary, so the URL is read out of that rather than by
    # taking the last line — which was "}" and got aliased, loudly and uselessly.
    out="$(vercel deploy --yes 2>&1)"
    url="$(printf '%s' "$out" | python3 -c '
import json,re,sys
raw = sys.stdin.read()
m = re.search(r"\{[\s\S]*\}\s*$", raw)
if m:
    try:
        d = json.loads(m.group(0))
        u = (d.get("deployment") or {}).get("url") or d.get("url") or ""
        if u:
            print(u if u.startswith("http") else "https://" + u); sys.exit()
    except Exception:
        pass
hits = re.findall(r"https://[a-z0-9-]+\.vercel\.app", raw)
print(hits[-1] if hits else "")
')"
    if [ -z "$url" ]; then printf "%s\n" "$out" | tail -20; echo "could not find the deployment URL" >&2; exit 1; fi
    echo "deployed $url"
    vercel alias set "$url" bolo-bill-staging.vercel.app
    echo "staging is https://bolo-bill-staging.vercel.app"
    ;;

  deploy)
    # Production is deployed from main and nowhere else. Shipping a half-finished branch
    # to the shops is a single mistyped word away otherwise, and there is no undo that the
    # shopkeeper does not see.
    if [ "$(branch)" != "main" ]; then
      echo "On $(branch), not main. Merge to main first, or use: ./bolo staging" >&2
      exit 1
    fi
    if [ -n "$(git status --porcelain)" ]; then
      echo "Uncommitted changes. Production deploys only what is in git." >&2
      exit 1
    fi
    ./stamp.sh
    exec vercel deploy --prod --yes
    ;;

  env)
    # `vercel env add` refuses to overwrite, so rotating a key used to mean knowing to
    # remove it first — and a half-done rotation leaves the old, revoked value in place
    # while everything still reports "configured". Named a variable, this removes and
    # re-adds it in one go.
    #
    # The value is typed at Vercel's own prompt and goes straight to Vercel. It is not
    # echoed, not passed as an argument, and never lands in shell history or this repo.
    if [ -n "${2:-}" ]; then
      v="$2"
      echo "--- replacing $v ---"
      echo "Removing the old value (choose every environment it is set in):"
      vercel env rm "$v" || true
      echo "Now paste the new value:"
      vercel env add "$v"
      echo
      echo "Redeploy for it to take effect:  ./bolo deploy"
      echo "Then confirm it works: Settings -> Photo & recipe AI -> Run"
      exit 0
    fi
    echo "Paste each value at the prompt. Nothing is written to shell history."
    echo "Choose the environments when asked — Preview too, if staging should be usable."
    for v in SARVAM_API_KEY SUPABASE_URL SUPABASE_SERVICE_KEY ANTHROPIC_API_KEY; do
      echo "--- $v ---"
      vercel env add "$v" || true
    done
    echo
    echo "To replace one that is already set:  ./bolo env ANTHROPIC_API_KEY"
    echo "Then redeploy:  ./bolo deploy   (and/or)   ./bolo staging"
    ;;

  test)
    # Everything, not just the parser. Each of these guards a bug that shipped: a wrong
    # unit conversion, a review screen that wrote without being asked, a day boundary in
    # the wrong timezone.
    .venv/bin/python tests/test_parser.py
    .venv/bin/python tests/test_aggregates.py
    .venv/bin/python tests/test_import.py
    .venv/bin/python tests/test_reorder.py
    .venv/bin/python tests/test_orders.py
    node tests/test_units.js
    node tests/test_wake.js
    ;;
  login)  exec gh auth login ;;
  *) echo "usage: ./bolo {dev|staging|deploy|env [VAR]|test|login}"; exit 1 ;;
esac

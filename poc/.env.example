# Copy to .env.local for local dev, or set these in the Vercel project.
# Never commit real values — .env is gitignored.

# Speech recognition (required for the voice path; without it the app runs in text mode)
SARVAM_API_KEY=
SARVAM_MODEL=saarika:v2.5
SARVAM_LANGUAGE=ta-IN

# Sarvam returns no confidence score, so this stands in. Lower it to make the confirm
# gate stricter (accept >= 0.72, confirm >= 0.42).
ASSUMED_ASR_CONFIDENCE=0.92

# Storage (optional — falls back to the seed CSV in memory)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
